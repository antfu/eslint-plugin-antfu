{
  "name": "eslint-plugin-antfu",
  "type": "module",
  "version": "3.2.3",
  "packageManager": "pnpm@11.25.0",
  "description": "Anthony's opinionated ESLint rules",
  "author": "Anthony Fu <anthonyfu117@hotmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/antfu",
  "homepage": "https://github.com/antfu/eslint-plugin-antfu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antfu/eslint-plugin-antfu.git"
  },
  "bugs": "https://github.com/antfu/eslint-plugin-antfu/issues",
  "keywords": [
    "eslint-plugin"
  ],
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.mjs"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "eslint .",
    "prepublishOnly": "nr build",
    "release": "bumpp",
    "start": "tsx src/index.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepare": "simple-git-hooks && skills-npm"
  },
  "peerDependencies": {
    "eslint": "*"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@antfu/ni": "^30.5.0",
    "@antfu/utils": "^9.3.0",
    "@types/eslint": "^9.6.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/typescript-estree": "^8.69.0",
    "@typescript-eslint/utils": "^8.69.0",
    "bumpp": "^12.2.2",
    "eslint": "^10.9.1",
    "eslint-vitest-rule-tester": "^3.1.0",
    "jsonc-eslint-parser": "^3.3.0",
    "lint-staged": "^17.4.1",
    "simple-git-hooks": "^2.14.0",
    "skills-npm": "^1.2.0",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
